\code{\link[=get_PSM]{get_PSM()}}.}
\item{\code{"ATE"}}{\code{get_PSW(estimand = "ATE")} with a logistic score,
"IPTW (ATE)".}
\item{\code{"ATT"}, \code{"ATC"}}{"SMR weighting (ATT)" / "(ATC)".}
\item{\code{"ATO"}, \code{"ATM"}, \code{"EW"}}{"Overlap weighting (ATO)",
"Matching weighting (ATM)", "Entropy weighting (EW)".}
